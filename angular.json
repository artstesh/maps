{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "cache": {
      "enabled": false
    }
  },
  "projects": {
    "maps-components": {
      "projectType": "library",
      "root": "projects/maps-components",
      "sourceRoot": "projects/maps-components/src",
      "prefix": "lib",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/maps-components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/maps-components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/maps-components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/**/*.ts",
              "projects/**/*.component.html"
            ]
          }
        },
        "test": {
          "builder": "@angular-builders/custom-webpack:karma",
          "options": {
            "main": "projects/maps-components/src/test.ts",
            "tsConfig": "projects/maps-components/tsconfig.spec.json",
            "karmaConfig": "projects/maps-components/karma.conf.js",
            "codeCoverage": true,
            "customWebpackConfig": {
              "path": "./node_modules/@artstesh/forger/lib/webpack.config.js"
            }
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/maps-components/.storybook",
            "browserTarget": "maps-components:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/maps-components"
            ],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/maps-components/.storybook",
            "browserTarget": "maps-components:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/maps-components"
            ],
            "outputDir": "storybook-static"
          }
        }
      }
    }
  },
  "defaultProject": "maps-components"
}